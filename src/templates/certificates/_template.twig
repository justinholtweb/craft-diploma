<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: Georgia, 'Times New Roman', serif;
            text-align: center;
            padding: 60px 80px;
            background: #fff;
            color: #1a1a1a;
        }
        .certificate-border {
            border: 3px solid #1a56db;
            padding: 60px;
            min-height: 500px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }
        .certificate-title {
            font-size: 36px;
            color: #1a56db;
            margin-bottom: 20px;
            text-transform: uppercase;
            letter-spacing: 3px;
        }
        .certificate-body {
            font-size: 18px;
            line-height: 1.6;
            margin-bottom: 30px;
            max-width: 500px;
        }
        .certificate-name {
            font-size: 28px;
            font-weight: bold;
            margin: 10px 0;
        }
        .certificate-course {
            font-size: 22px;
            font-style: italic;
            margin: 10px 0;
        }
        .certificate-date {
            font-size: 14px;
            color: #666;
            margin-top: 20px;
        }
        .certificate-code {
            font-size: 12px;
            color: #999;
            margin-top: 30px;
            font-family: monospace;
        }
    </style>
</head>
<body>
    <div class="certificate-border">
        <div class="certificate-title">{{ title }}</div>
        <div class="certificate-body">{{ body }}</div>
        <div class="certificate-date">{{ metadata.issuedDate ?? certificate.issuedAt|date('F j, Y') }}</div>
        <div class="certificate-code">Verification: {{ certificate.verificationCode }}</div>
    </div>
</body>
</html>
