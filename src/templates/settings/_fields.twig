{# Field names carry no `settings[…]` prefix: `craft\base\Plugin::settingsResponse()` runs this
   template's output through `View::namespaceInputs(…, 'settings')`, so a name written as
   `settings[foo]` here posts as `settings[settings][foo]` and saves nothing at all — the screen
   looks perfect, Craft reports "Plugin settings saved", and every edit is silently discarded. #}
{% import '_includes/forms' as forms %}

<div id="fields">
    <h2>{{ 'General'|t('diploma') }}</h2>

    {{ forms.lightswitchField({
        label: 'Enable Certificates'|t('diploma'),
        instructions: 'Automatically issue certificates when courses are completed.'|t('diploma'),
        id: 'enableCertificates',
        name: 'enableCertificates',
        on: settings.enableCertificates,
    }) }}

    {{ forms.lightswitchField({
        label: 'Auto-Issue Certificates'|t('diploma'),
        instructions: 'Generate certificates automatically when a student completes a course.'|t('diploma'),
        id: 'autoIssueCertificate',
        name: 'autoIssueCertificate',
        on: settings.autoIssueCertificate,
    }) }}

    {{ forms.lightswitchField({
        label: 'Require Passing Quiz'|t('diploma'),
        instructions: 'Require students to pass the course quiz before marking as completed.'|t('diploma'),
        id: 'requirePassingQuiz',
        name: 'requirePassingQuiz',
        on: settings.requirePassingQuiz,
    }) }}

    {{ forms.textField({
        label: 'Default Passing Score (%)'|t('diploma'),
        instructions: 'Default minimum score for quizzes when not set per quiz.'|t('diploma'),
        id: 'defaultPassingScore',
        name: 'defaultPassingScore',
        value: settings.defaultPassingScore,
        type: 'number',
        min: 0,
        max: 100,
    }) }}

    <hr>

    <h2>{{ 'Course URLs'|t('diploma') }}</h2>

    {{ forms.lightswitchField({
        label: 'Enable Course URLs'|t('diploma'),
        instructions: 'Give published courses their own front-end URLs, routed to a template.'|t('diploma'),
        id: 'enableCourseUrls',
        name: 'enableCourseUrls',
        on: settings.enableCourseUrls,
        toggle: 'course-url-fields',
    }) }}

    <div id="course-url-fields" class="{{ not settings.enableCourseUrls ? 'hidden' }}">
        {{ forms.textField({
            label: 'Course URI Format'|t('diploma'),
            instructions: 'The URI pattern for courses, e.g. `courses/{slug}`.'|t('diploma'),
            id: 'courseUriFormat',
            name: 'courseUriFormat',
            value: settings.courseUriFormat,
            errors: settings.getErrors('courseUriFormat'),
            code: true,
        }) }}

        {{ forms.textField({
            label: 'Course Template'|t('diploma'),
            instructions: 'The template that renders a course page. It receives a `course` variable.'|t('diploma'),
            id: 'courseTemplate',
            name: 'courseTemplate',
            value: settings.courseTemplate,
            errors: settings.getErrors('courseTemplate'),
            code: true,
        }) }}
    </div>

    <hr>

    <h2>{{ 'Content'|t('diploma') }}</h2>

    <p>
        <a href="{{ url('diploma/settings/lesson-fields') }}">{{ 'Lesson Content Fields'|t('diploma') }}</a>
        — {{ 'design the rich-content fields (text, embedded PDF/video/images, links) available on every lesson.'|t('diploma') }}
    </p>

    <hr>

    <h2>{{ 'Integration Settings'|t('diploma') }}</h2>

    <p>
        <a href="{{ url('diploma/settings/certificates') }}">{{ 'Certificate Templates'|t('diploma') }}</a>
        {% if plugin.is('pro') %}
            | <a href="{{ url('diploma/settings/commerce') }}">{{ 'Commerce Integration'|t('diploma') }}</a>
            | <a href="{{ url('diploma/settings/headcount') }}">{{ 'Headcount Integration'|t('diploma') }}</a>
        {% endif %}
    </p>
</div>
